# Supabase project credentials. Copy this file to `.env.local` and fill in.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Environment identifier: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# Web Push (VAPID key from Supabase or your push provider)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# Sentry error tracking
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn-here

# Auto-generated build identifier (set by CI; leave blank locally)
NEXT_PUBLIC_BUILD_ID=

# Web app lock (specs/web-landing/spec.md). Unset or anything but "true" serves
# only the public landing page at / (the production default). Set "true" for
# app development, to use login, signup and the (app) routes locally. Leave it
# out of .env.local when running e2e: use npm run test:e2e:unlocked instead,
# so the dev server and the specs agree on the flag.
# NEXT_PUBLIC_WEB_APP_ENABLED=true

# Store listings for the official "Download on the App Store" / "Get it on
# Google Play" badges (apps/web/lib/app-links.ts). Leave unset until each
# listing is public: unset, blank, not an https URL on the store's own host
# (no credentials, no custom port), or an App Store URL for another app id
# renders a "Coming soon" badge. Setting the App Store URL also turns on
# Apple's Smart App Banner. Inlined at build time, so redeploy after changing.
NEXT_PUBLIC_APP_STORE_URL=
# NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/id6774629438
NEXT_PUBLIC_PLAY_STORE_URL=
# NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.elorated.mobile
