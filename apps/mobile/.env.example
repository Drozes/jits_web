# Supabase project credentials. Copy this file to `.env` and fill in.
# Both vars are loaded at runtime by `apps/mobile/lib/env.ts`.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sentry error tracking (optional in local dev). When unset, Sentry init is
# a no-op and errors stay local. Set in EAS secrets for preview / production
# builds. Get a DSN from https://sentry.io after creating a React Native
# project.
EXPO_PUBLIC_SENTRY_DSN=
