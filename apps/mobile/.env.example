# Supabase project credentials. Copy this file to `.env` and fill in.
# Both vars are loaded at runtime by `apps/mobile/lib/env.ts`.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Environment identifier: development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Sentry error tracking + in-app feedback.
# Runtime DSN (required to turn Sentry on; embedded in the app at build time).
EXPO_PUBLIC_SENTRY_DSN=
# Build-time only: enables source-map / dSYM upload so stack traces are
# readable. Optional, crash + feedback capture works without them. Set
# SENTRY_AUTH_TOKEN as an EAS secret (never commit it); org/project are slugs.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
