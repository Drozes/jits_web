{
  "expo": {
    "name": "ELO RATED",
    "slug": "elo-rated",
    "version": "1.0",
    "scheme": [
      "elorated"
    ],
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/146416ac-fdf5-4fa2-b58f-2ed7c00e0f42",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.elorated.mobile",
      "usesAppleSignIn": true,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSCameraUsageDescription": "ELO RATED uses your camera to record your matches.",
        "NSMicrophoneUsageDescription": "ELO RATED uses your microphone so your match recordings include audio."
      },
      "associatedDomains": [
        "applinks:elorated.com"
      ],
      "appleTeamId": "JK9Q5E3HT8"
    },
    "android": {
      "package": "com.elorated.mobile",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0F14"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "elorated.com",
              "pathPrefix": "/c/"
            },
            {
              "scheme": "https",
              "host": "elorated.com",
              "pathPrefix": "/athlete"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "AppCheckCore",
                "version": "11.2.0"
              }
            ]
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D0F14",
          "image": "./assets/splash-icon.png",
          "imageWidth": 280
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false,
          "configureAndroidBackup": false
        }
      ],
      "expo-apple-authentication",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ELO RATED uses your location when you go live or challenge someone, so nearby athletes can find you and your match can start on the same mat.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E63946",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ELO RATED uses your camera to record your matches.",
          "microphonePermission": "ELO RATED uses your microphone so your match recordings include audio.",
          "recordAudioAndroid": true
        }
      ],
      "expo-video",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "ELO RATED uses your photo library to save your match highlights.",
          "savePhotosPermission": "ELO RATED saves your match highlights to your photo library.",
          "granularPermissions": []
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.353209338104-h02rm11vkas4ko5rs4uodiefotpv72gp"
        }
      ],
      "@react-native-community/datetimepicker",
      "./plugins/with-android-backup-rules",
      "./plugins/with-write-storage-max-sdk",
      "./plugins/with-instagram-reels"
    ],
    "extra": {
      "eas": {
        "projectId": "146416ac-fdf5-4fa2-b58f-2ed7c00e0f42"
      },
      "router": {}
    },
    "owner": "drozes18"
  }
}
