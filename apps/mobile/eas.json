{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6774629438",
        "ascApiKeyPath": "/Users/msponagle/.appstoreconnect/private_keys/AuthKey_T6FCD76M5B.p8",
        "ascApiKeyId": "T6FCD76M5B",
        "ascApiKeyIssuerId": "69a6de71-088c-47e3-e053-5b8c7c11a4d1"
      },
      "android": {
        "serviceAccountKeyPath": "PLACEHOLDER_SERVICE_ACCOUNT_KEY_PATH",
        "track": "internal"
      }
    }
  }
}
