{
  "name": "jits",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:web": "npm run dev --workspace=@jits/web",
    "build:web": "npm run build --workspace=@jits/web",
    "test:web": "npm run test --workspace=@jits/web",
    "start:mobile": "npm run start --workspace=@jits/mobile",
    "typecheck:web": "npm run typecheck --workspace=@jits/web",
    "typecheck:shared": "npm run typecheck --workspace=@jits/shared",
    "typecheck:mobile": "npm run typecheck --workspace=@jits/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:types": "cd ../jr_be && supabase gen types typescript --local > ../jits_web/packages/shared/src/types/database.ts",
    "prepare": "husky",
    "match-loop": "tsx tools/match-loop/run.ts",
    "match-loop:typecheck": "tsc -p tools/match-loop",
    "match-loop:test": "tsx --test tools/match-loop/tests/guards.test.ts tools/match-loop/tests/protocol.test.ts tools/match-loop/tests/video-seed.test.ts"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
